<meta>
  title: Quotarelay Control Plane
  description: Thin frontend proof for shipped Quotarelay backend capabilities and proof state.
</meta>

<route>
  path: /control-plane
</route>

<template>
  <section class="hero">
    <p class="eyebrow">Quotarelay control plane</p>
    <h1 class="title">Backend truth, mirrored into view.</h1>
    <p class="subtitle">
      This page reads the current backend truth endpoint and renders the live MCP tool registry, retrieval contract,
      and focused proof commands without inventing extra runtime state.
    </p>

    <div class="hero-grid">
      <article class="stat">
        <span class="stat-label">Truth route</span>
        <div class="stat-value">{{ truthRoute() }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Shipped tools</span>
        <div class="stat-value">{{ backendTools().length }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Fetch state</span>
        <div class="stat-value">{{ fetchState() }}</div>
      </article>
    </div>

    <p v-if="fetchError()" class="inline-note inline-note--warn">{{ fetchError() }}</p>

    <div class="operator-start">
      <div>
        <p class="operator-label">First local run</p>
        <h2>Start the backend, sync a repo, then open this page with a root.</h2>
      </div>
      <ol class="operator-steps">
        <li>
          <span>Backend</span>
          <code>cargo run -p mcp-server -- --http 127.0.0.1:3030</code>
        </li>
        <li>
          <span>Sync</span>
          <code>cargo run -p mcp-server -- --cli sync &lt;repo_root&gt;</code>
        </li>
        <li>
          <span>Inspect</span>
          <code>?root=&lt;repo_root&gt;&amp;memory_query=&lt;query&gt;</code>
        </li>
      </ol>
    </div>

    <div class="truth-summary" aria-label="Backend truth summary">
      <div class="truth-summary__item" v-for="item in truthSummary()" :key="item.label">
        <span>{{ item.label }}</span>
        <strong>{{ item.value }}</strong>
        <p>{{ item.detail }}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Backend contract</h2>
    <div class="panel-grid">
      <article class="panel" v-for="tool in backendTools()" :key="tool.name">
        <span class="panel-label">MCP tool</span>
        <h3>{{ tool.name }}</h3>
        <p>{{ tool.description }}</p>
        <div class="chip-row">
          <span class="chip" v-for="signal in toolSignals(tool)" :key="signal">{{ signal }}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Backend proofs</h2>
    <div class="proof-grid">
      <article class="proof" v-for="proof in proofs()" :key="proof.id">
        <span class="proof-label status-ok">Boundary proof</span>
        <h3>{{ proofTitle(proof) }}</h3>
        <p class="command">{{ proof.command }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Retrieval truth</h2>
    <div class="panel-grid">
      <article class="panel" v-for="detail in retrievalTruth()" :key="detail.title">
        <span class="panel-label">{{ detail.state }}</span>
        <h3>{{ detail.title }}</h3>
        <p>{{ detail.description }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Config truth</h2>
    <div class="panel-grid">
      <article class="panel" v-for="detail in configTruth()" :key="detail.title">
        <span class="panel-label">{{ detail.state }}</span>
        <h3>{{ detail.title }}</h3>
        <p>{{ detail.description }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">CLI helpers</h2>
    <div class="proof-grid">
      <article class="proof" v-for="command in cliCommands()" :key="command.command">
        <span class="proof-label status-ok">Local command</span>
        <h3>{{ command.label }}</h3>
        <p class="command">{{ command.command }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Repository state</h2>
    <p v-if="repositoryFetchError()" class="inline-note inline-note--warn">{{ repositoryFetchError() }}</p>
    <div class="panel-grid">
      <article class="panel" v-for="repo in repositoryState()" :key="repo.repository.root">
        <span class="panel-label">{{ repo.sync.status }}</span>
        <h3>{{ repo.repository.name }}</h3>
        <p>{{ repo.repository.root }}</p>
        <div class="chip-row">
          <span class="chip">indexed files: {{ repo.sync.indexed_files }}</span>
          <span class="chip" v-if="repo.recent_context_run">recent query: {{ repo.recent_context_run.query }}</span>
        </div>
        <div class="chip-row" v-if="repo.repo_map">
          <span class="chip" v-for="dir in repo.repo_map.directories" :key="dir.path">
            {{ dir.path }}: {{ dir.indexed_files }}
          </span>
        </div>
        <div class="chip-row" v-if="repo.repo_map">
          <span class="chip" v-for="rustFile in repo.repo_map.rust_files" :key="rustFile.path">
            {{ rustFile.path }}: {{ rustFile.symbols.join(', ') }}
          </span>
        </div>
      </article>
      <article class="panel" v-if="repositoryState().length === 0">
        <span class="panel-label">{{ repositoryFetchState() }}</span>
        <h3>Registered repositories</h3>
        <p>Repository state is rendered only when the backend receives an explicit state root.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Memory state</h2>
    <p v-if="memoryFetchError()" class="inline-note inline-note--warn">{{ memoryFetchError() }}</p>
    <div class="panel-grid">
      <article class="panel" v-for="note in memoryState().notes" :key="note.id">
        <span class="panel-label">Memory note</span>
        <h3>{{ note.title }}</h3>
        <p>{{ note.content }}</p>
        <div class="chip-row">
          <span class="chip">{{ note.profile ?? 'normal' }}</span>
          <span class="chip" v-for="tag in note.tags" :key="tag">{{ tag }}</span>
        </div>
      </article>
      <article class="panel" v-if="memoryState().notes.length === 0">
        <span class="panel-label">{{ memoryFetchState() }}</span>
        <h3>Durable memory</h3>
        <p>Memory search is rendered only when the backend receives an explicit state root and query.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Run history</h2>
    <p v-if="runFetchError()" class="inline-note inline-note--warn">{{ runFetchError() }}</p>
    <div class="panel-grid">
      <article class="panel" v-for="run in runHistory()" :key="run.generated_at_epoch_ms">
        <span class="panel-label">Context run</span>
        <h3>{{ run.query }}</h3>
        <p>{{ run.generated_at_epoch_ms }}</p>
        <div class="chip-row">
          <span class="chip" v-if="run.budget">raw bytes: {{ run.budget.raw_bytes_considered }}</span>
          <span class="chip" v-if="run.budget">included bytes: {{ run.budget.included_bytes }}</span>
          <span class="chip" v-if="run.budget">approx tokens: {{ run.budget.approximate_tokens }}</span>
          <span class="chip" v-if="run.budget">reduction: {{ Math.round((run.budget.estimated_reduction_ratio || 0) * 100) }}%</span>
          <span class="chip" v-if="run.cache_status">cache: {{ run.cache_status.kind }}</span>
          <span class="chip" v-if="run.stale">{{ run.stale.is_stale ? 'stale' : 'fresh' }}</span>
          <span class="chip" v-for="snippet in run.snippets" :key="snippet.path">{{ snippet.reason.kind }}</span>
          <span class="chip" v-for="omission in run.omissions" :key="omission.kind">{{ omission.kind }}</span>
        </div>
      </article>
      <article class="panel" v-if="runHistory().length === 0">
        <span class="panel-label">{{ runFetchState() }}</span>
        <h3>Context runs</h3>
        <p>Run history is rendered only when the backend receives an explicit state root.</p>
      </article>
    </div>
  </section>
</template>

<script>
  import { ref } from '@terajs/reactivity'
  import { onMounted } from '@terajs/runtime'
  import { loadBackendTruth, loadContextRunState, loadMemoryState, loadRepositoryState, proofTitle, toolSignals } from '../truth'

  const truthRouteRef = ref('/truth')
  const fetchStateRef = ref('Loading')
  const fetchErrorRef = ref('')
  const backendToolsRef = ref([])
  const proofsRef = ref([])
  const truthSummaryRef = ref([])
  const retrievalTruthRef = ref([])
  const configTruthRef = ref([])
  const cliCommandsRef = ref([])
  const repositoryStateRef = ref([])
  const repositoryFetchStateRef = ref('Not configured')
  const repositoryFetchErrorRef = ref('')
  const memoryStateRef = ref({ notes: [], omitted_count: 0 })
  const memoryFetchStateRef = ref('Not configured')
  const memoryFetchErrorRef = ref('')
  const runHistoryRef = ref([])
  const runFetchStateRef = ref('Not configured')
  const runFetchErrorRef = ref('')

  function truthRoute() {
    return truthRouteRef.value
  }

  function fetchState() {
    return fetchStateRef.value
  }

  function fetchError() {
    return fetchErrorRef.value
  }

  function backendTools() {
    return backendToolsRef.value
  }

  function proofs() {
    return proofsRef.value
  }

  function truthSummary() {
    return truthSummaryRef.value
  }

  function retrievalTruth() {
    return retrievalTruthRef.value
  }

  function configTruth() {
    return configTruthRef.value
  }

  function cliCommands() {
    return cliCommandsRef.value
  }

  function repositoryState() {
    return repositoryStateRef.value
  }

  function repositoryFetchState() {
    return repositoryFetchStateRef.value
  }

  function repositoryFetchError() {
    return repositoryFetchErrorRef.value
  }

  function memoryState() {
    return memoryStateRef.value
  }

  function memoryFetchState() {
    return memoryFetchStateRef.value
  }

  function memoryFetchError() {
    return memoryFetchErrorRef.value
  }

  function runHistory() {
    return runHistoryRef.value
  }

  function runFetchState() {
    return runFetchStateRef.value
  }

  function runFetchError() {
    return runFetchErrorRef.value
  }

  async function loadTruthIntoState() {
    fetchStateRef.value = 'Loading'
    fetchErrorRef.value = ''
    const state = await loadBackendTruth(fetch, truthRouteRef.value)
    backendToolsRef.value = state.backendTools
    proofsRef.value = state.proofs
    truthSummaryRef.value = state.truthSummary
    retrievalTruthRef.value = state.retrievalTruth
    configTruthRef.value = state.configTruth
    cliCommandsRef.value = state.cliCommands
    fetchStateRef.value = state.fetchState
    fetchErrorRef.value = state.fetchError

    const root = new URLSearchParams(window.location.search).get('root') ?? ''
    const repositoryState = await loadRepositoryState(fetch, root)
    repositoryStateRef.value = repositoryState.repositories
    repositoryFetchStateRef.value = repositoryState.fetchState
    repositoryFetchErrorRef.value = repositoryState.fetchError

    const memoryQuery = new URLSearchParams(window.location.search).get('memory_query') ?? ''
    const memoryState = await loadMemoryState(fetch, root, memoryQuery)
    memoryStateRef.value = memoryState.memory
    memoryFetchStateRef.value = memoryState.fetchState
    memoryFetchErrorRef.value = memoryState.fetchError

    const runState = await loadContextRunState(fetch, root)
    runHistoryRef.value = runState.runs
    runFetchStateRef.value = runState.fetchState
    runFetchErrorRef.value = runState.fetchError
  }

  onMounted(() => {
    void loadTruthIntoState()
  })
</script>
