<meta>
  title: Quotarelay
  description: Local MCP context dashboard for coding agents, with system health, usage, savings proof, cache status, memory, and no provider calls.
  keywords: quotarelay, mcp, coding agents, context dashboard, local first, usage stats
</meta>

<route>
  path: /
</route>

<script>
  import { ref } from '@terajs/reactivity'
  import { onMounted } from '@terajs/runtime'
  import { loadBackendTruth, loadContextRunState, loadMemoryState, loadRepositoryState } from '../truth'

  const benchmarkMetrics = [
    { name: 'Exact search', mode: 'exact_search', reduction: '94.36%', rawBytes: '24,132', packetBytes: '1,361', packetTokens: '341' },
    { name: 'Overview', mode: 'overview', reduction: '94.05%', rawBytes: '24,132', packetBytes: '1,435', packetTokens: '359' },
    { name: 'Handoff packet', mode: 'handoff_packet', reduction: '88.91%', rawBytes: '24,132', packetBytes: '2,676', packetTokens: '669' },
    { name: 'Diff aware', mode: 'diff_aware', reduction: '93.15%', rawBytes: '24,274', packetBytes: '1,663', packetTokens: '416' }
  ]

  const fetchStateRef = ref('Loading')
  const fetchErrorRef = ref('')
  const backendToolsRef = ref([])
  const truthSummaryRef = ref([])
  const repositoryStateRef = ref([])
  const repositoryFetchStateRef = ref('Not configured')
  const memoryStateRef = ref({ notes: [], omitted_count: 0 })
  const memoryFetchStateRef = ref('Not configured')
  const runHistoryRef = ref([])
  const runFetchStateRef = ref('Not configured')

  function summaryValue(label, fallback) {
    return truthSummaryRef.value.find((item) => item.label === label)?.value ?? fallback
  }

  function summaryDetail(label, fallback) {
    return truthSummaryRef.value.find((item) => item.label === label)?.detail ?? fallback
  }

  function backendOnline() {
    return fetchStateRef.value === 'Live'
  }

  function backendStatusLabel() {
    if (fetchStateRef.value === 'Loading') {
      return 'Checking'
    }
    return backendOnline() ? 'Backend online' : 'Backend offline'
  }

  function backendStatusTone() {
    if (fetchStateRef.value === 'Loading') {
      return 'warn'
    }
    return backendOnline() ? 'ok' : 'warn'
  }

  function backendPillClass() {
    return `status-pill status-pill--${backendStatusTone()}`
  }

  function statusBannerClass() {
    return `status-banner status-banner--${backendStatusTone()}`
  }

  function kpiClass(item) {
    return `kpi-card kpi-card--${item.tone}`
  }

  function compactStatClass(item) {
    return `compact-stat compact-stat--${item.tone}`
  }

  function backendStatusDetail() {
    if (backendOnline()) {
      return 'Live local truth is connected.'
    }
    return 'Start the loopback backend to show live repository usage.'
  }

  function healthStats() {
    return [
      { label: 'Backend', value: backendOnline() ? 'Online' : 'Offline', detail: backendOnline() ? 'Local truth endpoint connected' : 'Run the local backend', tone: backendOnline() ? 'ok' : 'warn' },
      { label: 'MCP tools', value: backendToolsRef.value.length > 0 ? String(backendToolsRef.value.length) : '35', detail: backendToolsRef.value.length > 0 ? 'reported by /truth' : 'release proof count', tone: 'ok' },
      { label: 'Retrieval modes', value: summaryValue('Retrieval', '4 modes'), detail: summaryDetail('Retrieval', 'exact_search, overview, task_capsule, diff_aware'), tone: 'ok' },
      { label: 'Cache', value: summaryValue('Cache', 'hit proven'), detail: summaryDetail('Cache', 'repeat exact search returns a cache hit'), tone: 'ok' },
      { label: 'Provider calls', value: 'none', detail: 'local demo proof', tone: 'ok' }
    ]
  }

  function usageStats() {
    const latestRun = runHistoryRef.value[0]
    const latestReduction = latestRun?.budget?.estimated_reduction_ratio
    const reductionLabel = typeof latestReduction === 'number'
      ? `${Math.round(latestReduction * 100)}%`
      : '94.36%'

    return [
      { label: 'Repositories', value: repositoryStateRef.value.length > 0 ? String(repositoryStateRef.value.length) : '0', detail: repositoryStateRef.value.length > 0 ? 'registered locally' : repositoryFetchStateRef.value, tone: repositoryStateRef.value.length > 0 ? 'ok' : 'muted' },
      { label: 'Recent runs', value: runHistoryRef.value.length > 0 ? String(runHistoryRef.value.length) : '0', detail: runHistoryRef.value.length > 0 ? 'context history loaded' : runFetchStateRef.value, tone: runHistoryRef.value.length > 0 ? 'ok' : 'muted' },
      { label: 'Memory matches', value: memoryStateRef.value.notes.length > 0 ? String(memoryStateRef.value.notes.length) : '0', detail: memoryStateRef.value.notes.length > 0 ? 'bounded local notes' : memoryFetchStateRef.value, tone: memoryStateRef.value.notes.length > 0 ? 'ok' : 'muted' },
      { label: 'Best reduction', value: reductionLabel, detail: latestRun ? 'latest local run' : 'benchmark baseline', tone: 'ok' }
    ]
  }

  function benchmarkStats() {
    return benchmarkMetrics
  }

  function emptyStates() {
    return {
      repositories: {
        title: 'No repository selected',
        detail: 'Add a root query parameter to inspect registered local repository state.',
        command: '?root=C:\\path\\to\\repo'
      },
      runs: {
        title: 'No recent runs loaded',
        detail: 'Assemble context for the selected root, then refresh the dashboard.',
        command: '--cli assemble <repo_root> exact_search <query> 3'
      },
      memory: {
        title: 'No memory query selected',
        detail: 'Add a memory query with the same root to show bounded local notes.',
        command: '&memory_query=decision'
      }
    }
  }

  function repositories() {
    return repositoryStateRef.value
  }

  function memoryNotes() {
    return memoryStateRef.value.notes
  }

  function runs() {
    return runHistoryRef.value
  }

  function runReduction(run) {
    const ratio = run?.budget?.estimated_reduction_ratio
    return typeof ratio === 'number' ? `${Math.round(ratio * 100)}%` : 'not reported'
  }

  async function loadDashboard() {
    const truth = await loadBackendTruth(fetch, '/truth')
    fetchStateRef.value = truth.fetchState
    fetchErrorRef.value = truth.fetchError
    backendToolsRef.value = truth.backendTools
    truthSummaryRef.value = truth.truthSummary

    const params = new URLSearchParams(window.location.search)
    const root = params.get('root') ?? ''
    const memoryQuery = params.get('memory_query') ?? ''

    const repositoryState = await loadRepositoryState(fetch, root)
    repositoryStateRef.value = repositoryState.repositories
    repositoryFetchStateRef.value = repositoryState.fetchState

    const memoryState = await loadMemoryState(fetch, root, memoryQuery)
    memoryStateRef.value = memoryState.memory
    memoryFetchStateRef.value = memoryState.fetchState

    const runState = await loadContextRunState(fetch, root)
    runHistoryRef.value = runState.runs
    runFetchStateRef.value = runState.fetchState
  }

  onMounted(() => {
    void loadDashboard()
  })
</script>

<template>
  <main class="dashboard-shell">
    <header class="app-header">
      <div>
        <p class="eyebrow">Local operator dashboard</p>
        <h1>Quotarelay</h1>
        <p>Monitor local context health, usage, cache behavior, memory matches, and benchmark savings.</p>
      </div>
      <div class="header-actions">
        <span :class="backendPillClass()">{{ backendStatusLabel() }}</span>
        <a class="button button--primary" href="https://github.com/quotarelay/quotarelay">GitHub</a>
        <a class="button button--secondary" href="https://github.com/quotarelay/quotarelay#quickstart">Quickstart</a>
      </div>
    </header>

    <section :class="statusBannerClass()">
      <strong>{{ backendStatusLabel() }}</strong>
      <span v-if="fetchError()">{{ fetchError() }}</span>
      <span v-else>{{ backendStatusDetail() }}</span>
      <code>cargo run -p mcp-server -- --http 127.0.0.1:3030</code>
    </section>

    <section class="kpi-grid" aria-label="System health">
      <article :class="kpiClass(item)" v-for="item in healthStats()" :key="item.label">
        <span>{{ item.label }}</span>
        <strong>{{ item.value }}</strong>
        <p>{{ item.detail }}</p>
      </article>
    </section>

    <div class="dashboard-layout">
      <section class="dashboard-panel dashboard-panel--wide">
        <div class="section-heading">
          <p class="eyebrow">Usage</p>
          <h2>Local activity</h2>
          <p>Live repository state appears when the dashboard receives a root parameter.</p>
        </div>
        <div class="usage-metrics">
          <article :class="compactStatClass(item)" v-for="item in usageStats()" :key="item.label">
            <span>{{ item.label }}</span>
            <strong>{{ item.value }}</strong>
            <p>{{ item.detail }}</p>
          </article>
        </div>
        <div class="usage-columns">
          <article class="data-panel">
            <span>Repositories</span>
            <div v-if="repositories().length > 0">
              <h3>{{ repositories()[0].repository.name }}</h3>
              <p>{{ repositories()[0].repository.root }}</p>
              <div class="dashboard-chip-row">
                <span class="dashboard-chip">status: {{ repositories()[0].sync.status }}</span>
                <span class="dashboard-chip">indexed files: {{ repositories()[0].sync.indexed_files }}</span>
              </div>
            </div>
            <div class="empty-state" v-else>
              <strong>{{ emptyStates().repositories.title }}</strong>
              <p>{{ emptyStates().repositories.detail }}</p>
              <code>{{ emptyStates().repositories.command }}</code>
            </div>
          </article>

          <article class="data-panel">
            <span>Recent runs</span>
            <div v-if="runs().length > 0">
              <div class="run-row" v-for="run in runs()" :key="run.generated_at_epoch_ms">
                <strong>{{ run.query }}</strong>
                <em>{{ runReduction(run) }}</em>
                <p>
                  {{ run.budget?.included_bytes ?? 0 }} of {{ run.budget?.raw_bytes_considered ?? 0 }} bytes;
                  cache {{ run.cache_status?.kind ?? 'not reported' }};
                  {{ run.stale?.is_stale ? 'stale' : 'fresh' }}
                </p>
              </div>
            </div>
            <div class="empty-state" v-else>
              <strong>{{ emptyStates().runs.title }}</strong>
              <p>{{ emptyStates().runs.detail }}</p>
              <code>{{ emptyStates().runs.command }}</code>
            </div>
          </article>

          <article class="data-panel">
            <span>Memory matches</span>
            <div v-if="memoryNotes().length > 0">
              <div class="memory-row" v-for="note in memoryNotes()" :key="note.id">
                <strong>{{ note.title }}</strong>
                <p>{{ note.content }}</p>
              </div>
            </div>
            <div class="empty-state" v-else>
              <strong>{{ emptyStates().memory.title }}</strong>
              <p>{{ emptyStates().memory.detail }}</p>
              <code>{{ emptyStates().memory.command }}</code>
            </div>
          </article>
        </div>
      </section>

      <section class="dashboard-panel">
        <div class="section-heading">
          <p class="eyebrow">System health</p>
          <h2>Boundaries</h2>
          <p>Local-only operation stays explicit.</p>
        </div>
        <div class="health-list">
          <article>
            <span>Provider calls</span>
            <strong>none</strong>
          </article>
          <article>
            <span>State location</span>
            <strong>.quotarelay</strong>
          </article>
          <article>
            <span>HTTP bind</span>
            <strong>loopback</strong>
          </article>
          <article>
            <span>Billing claims</span>
            <strong>none</strong>
          </article>
        </div>
      </section>

      <section class="dashboard-panel dashboard-panel--wide">
        <div class="section-heading">
          <p class="eyebrow">Savings proof</p>
          <h2>Token-saver benchmark</h2>
          <p>Local byte and approximate-token estimates from the checked-in benchmark fixture.</p>
        </div>
        <div class="savings-table">
          <article class="savings-row" v-for="metric in benchmarkStats()" :key="metric.mode">
            <div>
              <strong>{{ metric.name }}</strong>
              <span>{{ metric.mode }}</span>
            </div>
            <div class="savings-bar">
              <span :style="`width: ${metric.reduction}`"></span>
            </div>
            <strong>{{ metric.reduction }}</strong>
            <p>{{ metric.packetBytes }} packet bytes from {{ metric.rawBytes }} raw bytes; {{ metric.packetTokens }} approximate packet tokens.</p>
          </article>
        </div>
      </section>

      <section class="dashboard-panel">
        <div class="section-heading">
          <p class="eyebrow">Setup</p>
          <h2>Compact workflow</h2>
          <p>Enough to start the local operator loop.</p>
        </div>
        <ol class="setup-list">
          <li>
            <span>1</span>
            <div>
              <strong>Run proof</strong>
              <code>scripts\demo-local.ps1</code>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <strong>Install command</strong>
              <code>quotarelay-mcp</code>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <strong>Sync repo</strong>
              <code>--cli sync repo</code>
            </div>
          </li>
        </ol>
      </section>
    </div>
  </main>
</template>
