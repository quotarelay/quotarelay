<meta>
  title: Quotarelay Control Plane
  description: Thin frontend proof for shipped Quotarelay backend capabilities and proof state.
</meta>

<template>
  <section class="hero">
    <p class="eyebrow">Quotarelay control plane</p>
    <h1 class="title">Backend truth, mirrored into view.</h1>
    <p class="subtitle">
      This page reads the current backend truth endpoint and renders the live MCP tool registry, retrieval contract,
      and focused proof commands without inventing extra runtime state.
    </p>

    <div class="hero-grid">
      <article class="stat">
        <span class="stat-label">Truth route</span>
        <div class="stat-value">{{ truthRoute() }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Shipped tools</span>
        <div class="stat-value">{{ backendTools().length }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Fetch state</span>
        <div class="stat-value">{{ fetchState() }}</div>
      </article>
    </div>

    <p v-if="fetchError()" class="inline-note inline-note--warn">{{ fetchError() }}</p>
  </section>

  <section class="section">
    <h2 class="section-title">Backend contract</h2>
    <div class="panel-grid">
      <article class="panel" v-for="tool in backendTools()" :key="tool.name">
        <span class="panel-label">MCP tool</span>
        <h3>{{ tool.name }}</h3>
        <p>{{ tool.description }}</p>
        <div class="chip-row">
          <span class="chip" v-for="signal in toolSignals(tool)" :key="signal">{{ signal }}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Backend proofs</h2>
    <div class="proof-grid">
      <article class="proof" v-for="proof in proofs()" :key="proof.id">
        <span class="proof-label status-ok">Boundary proof</span>
        <h3>{{ proofTitle(proof) }}</h3>
        <p class="command">{{ proof.command }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Retrieval truth</h2>
    <div class="panel-grid">
      <article class="panel" v-for="detail in retrievalTruth()" :key="detail.title">
        <span class="panel-label">{{ detail.state }}</span>
        <h3>{{ detail.title }}</h3>
        <p>{{ detail.description }}</p>
      </article>
    </div>
  </section>
</template>

<script>
  import { ref, shallowRef } from '@terajs/reactivity'
  import { onMounted } from '@terajs/runtime'

  const truthRouteRef = ref('/truth')
  const fetchStateRef = ref('Loading')
  const fetchErrorRef = ref('')
  const backendToolsRef = shallowRef([])
  const proofsRef = shallowRef([])
  const retrievalTruthRef = shallowRef([])

  function truthRoute() {
    return truthRouteRef.value
  }

  function fetchState() {
    return fetchStateRef.value
  }

  function fetchError() {
    return fetchErrorRef.value
  }

  function backendTools() {
    return backendToolsRef.value
  }

  function proofs() {
    return proofsRef.value
  }

  function retrievalTruth() {
    return retrievalTruthRef.value
  }

  function formatList(values) {
    return values.length > 0 ? values.join(', ') : 'none'
  }

  function toolSignals(tool) {
    const schema = tool?.inputSchema
    if (!schema || typeof schema !== 'object') {
      return ['no schema']
    }

    const required = Array.isArray(schema.required) ? schema.required : []
    const properties = schema.properties && typeof schema.properties === 'object'
      ? Object.keys(schema.properties)
      : []

    if (required.length === 0 && properties.length === 0) {
      return ['no input']
    }

    const chips = []
    if (required.length > 0) {
      chips.push(`required: ${required.join(', ')}`)
    }
    if (properties.length > 0) {
      chips.push(`fields: ${properties.join(', ')}`)
    }
    return chips
  }

  function proofTitle(proof) {
    return String(proof?.id ?? 'proof').replaceAll('_', ' ')
  }

  function toRetrievalTruthItems(retrieval) {
    const limits = retrieval?.limits ?? {}
    return [
      {
        state: 'Modes',
        title: 'Retrieval modes',
        description: formatList(Array.isArray(retrieval?.modes) ? retrieval.modes : [])
      },
      {
        state: 'Inclusion',
        title: 'Inclusion reason kinds',
        description: formatList(Array.isArray(retrieval?.inclusion_reason_kinds) ? retrieval.inclusion_reason_kinds : [])
      },
      {
        state: 'Omission',
        title: 'Omission reason kinds',
        description: formatList(Array.isArray(retrieval?.omission_reason_kinds) ? retrieval.omission_reason_kinds : [])
      },
      {
        state: 'Limits',
        title: 'Hard limits',
        description: `items ${limits.max_context_items ?? 0}; snippet bytes ${limits.max_snippet_pack_bytes ?? 0}; document bytes ${limits.max_document_pack_bytes ?? 0}; memory bytes ${limits.max_memory_pack_bytes ?? 0}; history runs ${limits.max_history_runs ?? 0}`
      },
      {
        state: 'Memory',
        title: 'Durable memory',
        description: retrieval?.durable_memory_enabled ? 'enabled' : 'disabled'
      },
      {
        state: 'Mirror',
        title: 'Truth source',
        description: 'Rendered from the live backend /truth payload.'
      }
    ]
  }

  async function loadBackendTruth() {
    fetchStateRef.value = 'Loading'
    fetchErrorRef.value = ''

    try {
      const response = await fetch(truthRouteRef.value, {
        headers: {
          accept: 'application/json'
        }
      })

      if (!response.ok) {
        throw new Error(`GET ${truthRouteRef.value} returned ${response.status}`)
      }

      const payload = await response.json()
      backendToolsRef.value = Array.isArray(payload?.tools) ? payload.tools : []
      proofsRef.value = Array.isArray(payload?.proofs) ? payload.proofs : []
      retrievalTruthRef.value = toRetrievalTruthItems(payload?.retrieval)
      fetchStateRef.value = 'Live'
    } catch (error) {
      backendToolsRef.value = []
      proofsRef.value = []
      retrievalTruthRef.value = []
      fetchStateRef.value = 'Unavailable'
      fetchErrorRef.value = error instanceof Error ? error.message : 'Failed to load /truth'
    }
  }

  onMounted(() => {
    void loadBackendTruth()
  })
</script>