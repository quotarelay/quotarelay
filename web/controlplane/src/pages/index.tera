<meta>
  title: Quotarelay
  description: Local MCP context dashboard for coding agents, with command-center health, usage, savings proof, cache status, memory, and no provider calls.
  keywords: quotarelay, mcp, coding agents, context dashboard, local first, usage stats
</meta>

<route>
  path: /
</route>

<script>
  import { ref } from '@terajs/reactivity'
  import { onMounted } from '@terajs/runtime'
  import { loadBackendTruth, loadContextRunState, loadMemoryState, loadRepositoryState } from '../truth'

  const THEME_KEY = 'quotarelay.theme'
  const themeModeRef = ref('system')
  const fetchStateRef = ref('Loading')
  const fetchErrorRef = ref('')
  const backendToolsRef = ref([])
  const truthSummaryRef = ref([])
  const repositoryStateRef = ref([])
  const repositoryFetchStateRef = ref('Not configured')
  const memoryStateRef = ref({ notes: [], omitted_count: 0 })
  const memoryFetchStateRef = ref('Not configured')
  const runHistoryRef = ref([])
  const runFetchStateRef = ref('Not configured')

  const benchmarkMetrics = [
    { name: 'Exact search', mode: 'exact_search', reduction: '94.36%', rawBytes: '24,132', packetBytes: '1,361', packetTokens: '341' },
    { name: 'Overview', mode: 'overview', reduction: '94.05%', rawBytes: '24,132', packetBytes: '1,435', packetTokens: '359' },
    { name: 'Handoff packet', mode: 'handoff_packet', reduction: '88.91%', rawBytes: '24,132', packetBytes: '2,676', packetTokens: '669' },
    { name: 'Diff aware', mode: 'diff_aware', reduction: '93.15%', rawBytes: '24,274', packetBytes: '1,663', packetTokens: '416' }
  ]

  function summaryValue(label, fallback) {
    return truthSummaryRef.value.find((item) => item.label === label)?.value ?? fallback
  }

  function summaryDetail(label, fallback) {
    return truthSummaryRef.value.find((item) => item.label === label)?.detail ?? fallback
  }

  function backendOnline() {
    return fetchStateRef.value === 'Live'
  }

  function backendStatusLabel() {
    if (fetchStateRef.value === 'Loading') {
      return 'Checking'
    }
    return backendOnline() ? 'Backend online' : 'Backend offline'
  }

  function backendStatusTone() {
    if (fetchStateRef.value === 'Loading') {
      return 'warn'
    }
    return backendOnline() ? 'ok' : 'warn'
  }

  function heroStatus() {
    const latestRun = runHistoryRef.value[0]
    const latestReduction = latestRun?.budget?.estimated_reduction_ratio
    return {
      label: backendStatusLabel(),
      tone: backendStatusTone(),
      detail: backendOnline()
        ? 'Live local truth is connected.'
        : 'Start the loopback backend to show live repository usage.',
      command: 'cargo run -p mcp-server -- --http 127.0.0.1:3030',
      providerCalls: 'none',
      cache: summaryValue('Cache', 'hit proven'),
      reduction: typeof latestReduction === 'number' ? `${Math.round(latestReduction * 100)}%` : '94.36%'
    }
  }

  function metricRail() {
    return [
      { label: 'MCP tools', value: backendToolsRef.value.length > 0 ? String(backendToolsRef.value.length) : '35', detail: backendToolsRef.value.length > 0 ? 'live /truth' : 'release proof' },
      { label: 'Retrieval', value: summaryValue('Retrieval', '4 modes'), detail: summaryDetail('Retrieval', 'exact, overview, task, diff') },
      { label: 'Recent runs', value: runHistoryRef.value.length > 0 ? String(runHistoryRef.value.length) : '0', detail: runHistoryRef.value.length > 0 ? 'loaded locally' : runFetchStateRef.value },
      { label: 'Memory matches', value: memoryStateRef.value.notes.length > 0 ? String(memoryStateRef.value.notes.length) : '0', detail: memoryStateRef.value.notes.length > 0 ? 'bounded notes' : memoryFetchStateRef.value }
    ]
  }

  function usageRows() {
    const repo = repositoryStateRef.value[0]
    const run = runHistoryRef.value[0]
    const note = memoryStateRef.value.notes[0]
    return [
      {
        label: 'Repository',
        value: repo?.repository?.name ?? 'No repository selected',
        detail: repo ? `${repo.sync?.indexed_files ?? 0} indexed files` : 'Add a root query parameter.',
        meta: repo?.sync?.status ?? '?root=C:\\path\\to\\repo'
      },
      {
        label: 'Recent run',
        value: run?.query ?? 'No recent runs loaded',
        detail: run ? `${run.budget?.included_bytes ?? 0} of ${run.budget?.raw_bytes_considered ?? 0} bytes included` : 'Assemble context for the selected root.',
        meta: run ? `cache ${run.cache_status?.kind ?? 'not reported'}` : '--cli assemble repo exact_search query 3'
      },
      {
        label: 'Memory',
        value: note?.title ?? 'No memory query selected',
        detail: note?.content ?? 'Add a memory query with the same root.',
        meta: note?.profile ?? '&memory_query=decision'
      }
    ]
  }

  function savingsRows() {
    return benchmarkMetrics
  }

  function boundaryRows() {
    return [
      { label: 'Provider calls', value: 'none' },
      { label: 'State location', value: '.quotarelay' },
      { label: 'HTTP bind', value: 'loopback' },
      { label: 'Billing claims', value: 'none' }
    ]
  }

  function themeOptions() {
    return [
      { value: 'system', label: 'System' },
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' }
    ]
  }

  function activeTheme() {
    return themeModeRef.value
  }

  function fetchError() {
    return fetchErrorRef.value
  }

  function themeButtonClass(mode) {
    return mode === themeModeRef.value ? 'theme-option theme-option--active' : 'theme-option'
  }

  function applyTheme(mode) {
    if (typeof document === 'undefined') {
      return
    }
    if (mode === 'light' || mode === 'dark') {
      document.documentElement.dataset.theme = mode
      document.documentElement.dataset.themePreference = mode
      return
    }
    delete document.documentElement.dataset.theme
    document.documentElement.dataset.themePreference = 'system'
  }

  function setTheme(mode) {
    const nextMode = mode === 'light' || mode === 'dark' ? mode : 'system'
    themeModeRef.value = nextMode
    applyTheme(nextMode)
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(THEME_KEY, nextMode)
    }
  }

  function loadThemePreference() {
    if (typeof localStorage === 'undefined') {
      return 'system'
    }
    const stored = localStorage.getItem(THEME_KEY)
    return stored === 'light' || stored === 'dark' ? stored : 'system'
  }

  async function loadDashboard() {
    const truth = await loadBackendTruth(fetch, '/truth')
    fetchStateRef.value = truth.fetchState
    fetchErrorRef.value = truth.fetchError
    backendToolsRef.value = truth.backendTools
    truthSummaryRef.value = truth.truthSummary

    const params = new URLSearchParams(window.location.search)
    const root = params.get('root') ?? ''
    const memoryQuery = params.get('memory_query') ?? ''

    const repositoryState = await loadRepositoryState(fetch, root)
    repositoryStateRef.value = repositoryState.repositories
    repositoryFetchStateRef.value = repositoryState.fetchState

    const memoryState = await loadMemoryState(fetch, root, memoryQuery)
    memoryStateRef.value = memoryState.memory
    memoryFetchStateRef.value = memoryState.fetchState

    const runState = await loadContextRunState(fetch, root)
    runHistoryRef.value = runState.runs
    runFetchStateRef.value = runState.fetchState
  }

  onMounted(() => {
    const theme = loadThemePreference()
    themeModeRef.value = theme
    applyTheme(theme)
    void loadDashboard()
  })
</script>

<template>
  <main class="command-shell">
    <header class="command-bar">
      <div>
        <p class="eyebrow">Local command center</p>
        <h1>Quotarelay</h1>
      </div>
      <div class="command-actions">
        <span :class="`status-pill status-pill--${heroStatus().tone}`">{{ heroStatus().label }}</span>
        <div class="theme-toggle" aria-label="Theme mode">
          <button
            v-for="option in themeOptions()"
            :key="option.value"
            type="button"
            :class="themeButtonClass(option.value)"
            @click="setTheme(option.value)"
          >
            {{ option.label }}
          </button>
        </div>
        <a class="button button--primary" href="https://github.com/quotarelay/quotarelay">GitHub</a>
        <a class="button button--secondary" href="https://github.com/quotarelay/quotarelay#quickstart">Quickstart</a>
      </div>
    </header>

    <section class="status-strip" v-if="!backendOnline()">
      <strong>Backend offline</strong>
      <span v-if="fetchError()">{{ fetchError() }}</span>
      <span v-else>{{ heroStatus().detail }}</span>
      <code>{{ heroStatus().command }}</code>
    </section>

    <section class="hero-summary">
      <div class="hero-summary__main">
        <p class="eyebrow">Local context status</p>
        <h2>{{ heroStatus().label }}</h2>
        <p>{{ heroStatus().detail }}</p>
      </div>
      <div class="summary-grid">
        <article>
          <span>Provider calls</span>
          <strong>{{ heroStatus().providerCalls }}</strong>
        </article>
        <article>
          <span>Cache</span>
          <strong>{{ heroStatus().cache }}</strong>
        </article>
        <article>
          <span>Best reduction</span>
          <strong>{{ heroStatus().reduction }}</strong>
        </article>
      </div>
    </section>

    <section class="metric-rail" aria-label="Dashboard metrics">
      <article v-for="metric in metricRail()" :key="metric.label">
        <span>{{ metric.label }}</span>
        <strong>{{ metric.value }}</strong>
        <p>{{ metric.detail }}</p>
      </article>
    </section>

    <div class="content-grid">
      <section class="surface-panel">
        <div class="section-heading">
          <p class="eyebrow">Usage</p>
          <h2>Local activity</h2>
        </div>
        <div class="data-list">
          <article class="data-row" v-for="row in usageRows()" :key="row.label">
            <span>{{ row.label }}</span>
            <div>
              <strong>{{ row.value }}</strong>
              <p>{{ row.detail }}</p>
            </div>
            <code>{{ row.meta }}</code>
          </article>
        </div>
      </section>

      <section class="surface-panel">
        <div class="section-heading">
          <p class="eyebrow">Savings proof</p>
          <h2>Benchmark comparison</h2>
        </div>
        <div class="savings-list">
          <article class="savings-row" v-for="metric in savingsRows()" :key="metric.mode">
            <div>
              <strong>{{ metric.name }}</strong>
              <span>{{ metric.mode }}</span>
            </div>
            <div class="savings-bar">
              <span :style="`width: ${metric.reduction}`"></span>
            </div>
            <strong>{{ metric.reduction }}</strong>
            <p>{{ metric.packetBytes }} packet bytes from {{ metric.rawBytes }} raw bytes.</p>
          </article>
        </div>
      </section>

      <section class="surface-panel surface-panel--compact">
        <div class="section-heading">
          <p class="eyebrow">Boundaries</p>
          <h2>System health</h2>
        </div>
        <div class="boundary-list">
          <article v-for="row in boundaryRows()" :key="row.label">
            <span>{{ row.label }}</span>
            <strong>{{ row.value }}</strong>
          </article>
        </div>
      </section>

      <section class="surface-panel surface-panel--compact">
        <div class="section-heading">
          <p class="eyebrow">Setup</p>
          <h2>Start loop</h2>
        </div>
        <ol class="setup-strip">
          <li><span>1</span><code>scripts\demo-local.ps1</code></li>
          <li><span>2</span><code>quotarelay-mcp</code></li>
          <li><span>3</span><code>--cli sync repo</code></li>
        </ol>
      </section>
    </div>
  </main>
</template>
