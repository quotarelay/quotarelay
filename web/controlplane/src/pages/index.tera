<meta>
  title: Quotarelay Control Plane
  description: Thin frontend proof for shipped Quotarelay backend capabilities and proof state.
</meta>

<template>
  <section class="hero">
    <p class="eyebrow">Quotarelay control plane</p>
    <h1 class="title">Backend truth, mirrored into view.</h1>
    <p class="subtitle">
      This page mirrors the current MCP tool registry and the focused proofs behind it: structural Rust capsules,
      incremental local sync, symbol-first retrieval, explicit retrieval modes, typed explainability, hard packing
      budgets, and bounded context run history.
    </p>

    <div class="hero-grid">
      <article class="stat">
        <span class="stat-label">Current sprint</span>
        <div class="stat-value">{{ currentSprint }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Shipped tools</span>
        <div class="stat-value">{{ backendTools.length }}</div>
      </article>
      <article class="stat">
        <span class="stat-label">Proof mode</span>
        <div class="stat-value">Checked-in mirror</div>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Backend contract</h2>
    <div class="panel-grid">
      <article class="panel" v-for="tool in backendTools" :key="tool.name">
        <span class="panel-label">{{ tool.state }}</span>
        <h3>{{ tool.name }}</h3>
        <p>{{ tool.description }}</p>
        <div class="chip-row">
          <span class="chip" v-for="signal in tool.signals" :key="signal">{{ signal }}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Recent proof runs</h2>
    <div class="proof-grid">
      <article class="proof" v-for="proof in proofs" :key="proof.command">
        <span class="proof-label" :class="proof.statusClass">{{ proof.status }}</span>
        <h3>{{ proof.title }}</h3>
        <p>{{ proof.summary }}</p>
        <p class="command">{{ proof.command }}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Retrieval truth</h2>
    <div class="panel-grid">
      <article class="panel" v-for="detail in retrievalTruth" :key="detail.title">
        <span class="panel-label">{{ detail.state }}</span>
        <h3>{{ detail.title }}</h3>
        <p>{{ detail.description }}</p>
      </article>
    </div>
  </section>
</template>

<script>
  const currentSprint = 'S2 / T8'

  const backendTools = [
    {
      state: 'Shipped',
      name: 'bootstrap_status',
      description: 'Returns the current Quotarelay bootstrap banner over the MCP tools boundary.',
      signals: ['tools/list', 'tools/call', 'stdio MCP']
    },
    {
      state: 'Shipped',
      name: 'sync_repo',
      description: 'Scans a local repository, writes Rust structural capsules, reuses unchanged files, and prunes deleted ones under .quotarelay/.',
      signals: ['local filesystem', 'incremental add/change/delete', '8192-byte per-file cap']
    },
    {
      state: 'Shipped',
      name: 'repo_inventory',
      description: 'Returns repository inventory truth from the persisted index with a bounded path sample.',
      signals: ['indexed_files', 'sample_paths', 'indexed_at_epoch_ms']
    },
    {
      state: 'Shipped',
      name: 'search_code',
      description: 'Queries the persisted index with explicit hit limits and returns matching lines with symbol-first ordering before raw substring matches.',
      signals: ['limit clamp', 'symbol-first ordering', 'line hits only']
    },
    {
      state: 'Shipped',
      name: 'context_run_history',
      description: 'Returns recent bounded exact-search context runs with typed inclusion and omission reasons that were recorded locally.',
      signals: ['recent runs', 'typed reasons', 'history clamp 10']
    },
    {
      state: 'Shipped',
      name: 'assemble_context',
      description: 'Builds exact_search, overview, or task_capsule context packs with typed explainability and hard item and byte budgets.',
      signals: ['exact_search / overview / task_capsule', 'typed reasons', 'item + byte budgets']
    }
  ]

  const proofs = [
    {
      status: 'Passed',
      statusClass: 'status-ok',
      title: 'Tool registry proof',
      summary: 'The MCP tools list exposes the exact backend contract mirrored on this page.',
      command: 'cargo test -p mcp-server tools_list_exposes_current_backend_truth_surface'
    },
    {
      status: 'Passed',
      statusClass: 'status-ok',
      title: 'Incremental sync proof',
      summary: 'Repo sync now reuses unchanged files and handles add, change, and delete flows in the persisted local index.',
      command: 'cargo test -p repo-index sync_repo_updates_incrementally_for_add_change_delete'
    },
    {
      status: 'Passed',
      statusClass: 'status-ok',
      title: 'Retrieval mode proof',
      summary: 'The stdio MCP boundary exposes exact_search, overview, and task_capsule without moving retrieval logic out of the engine.',
      command: 'cargo test -p mcp-server assemble_context_supports_overview_and_task_capsule_modes_over_stdio'
    },
    {
      status: 'Passed',
      statusClass: 'status-ok',
      title: 'Budget and explainability proof',
      summary: 'Typed omission kinds and byte-budget truncation are preserved across the engine and stdio MCP boundary.',
      command: 'cargo test -p context-engine && cargo test -p mcp-server assemble_context_reports_byte_budget_omissions_over_stdio'
    },
    {
      status: 'Passed',
      statusClass: 'status-ok',
      title: 'Symbol-first proof',
      summary: 'Symbol-bearing declaration lines now beat earlier raw text mentions in search and task capsule assembly.',
      command: 'cargo test -p repo-index search_and_document_matching_prefer_symbol_hits && cargo test -p context-engine task_capsule_prefers_symbol_matches_before_raw_text_mentions'
    },
    {
      status: 'Pending build',
      statusClass: 'status-warn',
      title: 'Control-plane build proof',
      summary: 'The Terajs control plane must still build cleanly against the mirrored backend contract.',
      command: 'npm run build'
    }
  ]

  const retrievalTruth = [
    {
      state: 'Modes',
      title: 'Retrieval modes are explicit',
      description: 'assemble_context exposes exact_search, overview, and task_capsule. exact_search and task_capsule require a query; overview does not.'
    },
    {
      state: 'Explainability',
      title: 'Reason kinds are typed',
      description: 'Inclusion kinds are query_line_match, overview_document, and task_capsule_match. Omission kinds are no_line_matches, no_document_matches, item_limit_reached, and byte_budget_reached.'
    },
    {
      state: 'Budgets',
      title: 'Packing is hard-bounded',
      description: 'Exact-search packing clamps to 5 snippets and 160 bytes of line text. Overview and task capsules clamp to 5 documents and 640 bytes of document text.'
    },
    {
      state: 'Index',
      title: 'Stored artifacts stay bounded',
      description: 'Sync stores Rust structural capsules when parsing succeeds, falls back to raw text when it does not, and caps stored per-file contents at 8192 bytes.'
    },
    {
      state: 'Ordering',
      title: 'Retrieval is symbol-first',
      description: 'search_code and task capsule matching prefer declaration-like symbol lines before generic substring matches.'
    },
    {
      state: 'Mirror',
      title: 'No invented runtime state',
      description: 'This page mirrors checked-in backend contract and proof state. It does not claim live polling, savings metrics, or hidden readiness.'
    }
  ]
</script>