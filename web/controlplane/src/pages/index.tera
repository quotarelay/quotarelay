<meta>
  title: Quotarelay
  description: Local MCP context dashboard for coding agents, with focused status, usage, savings proof, cache state, memory, and no provider calls.
  keywords: quotarelay, mcp, coding agents, context dashboard, local first, usage stats
</meta>

<route>
  path: /
</route>

<script>
  import { ref } from '@terajs/reactivity'
  import { onMounted } from '@terajs/runtime'
  import { loadBackendTruth, loadContextRunState, loadMemoryState, loadRepositoryState } from '../truth'

  const THEME_KEY = 'quotarelay.theme'
  const themeModeRef = ref('system')
  const fetchStateRef = ref('Loading')
  const fetchErrorRef = ref('')
  const backendToolsRef = ref([])
  const truthSummaryRef = ref([])
  const repositoryStateRef = ref([])
  const repositoryFetchStateRef = ref('Not configured')
  const memoryStateRef = ref({ notes: [], omitted_count: 0 })
  const memoryFetchStateRef = ref('Not configured')
  const runHistoryRef = ref([])
  const runFetchStateRef = ref('Not configured')

  const benchmarkMetrics = [
    { name: 'Exact search', mode: 'exact_search', reduction: '94.36%', rawBytes: '24,132', packetBytes: '1,361', packetTokens: '341' },
    { name: 'Overview', mode: 'overview', reduction: '94.05%', rawBytes: '24,132', packetBytes: '1,435', packetTokens: '359' },
    { name: 'Handoff packet', mode: 'handoff_packet', reduction: '88.91%', rawBytes: '24,132', packetBytes: '2,676', packetTokens: '669' },
    { name: 'Diff aware', mode: 'diff_aware', reduction: '93.15%', rawBytes: '24,274', packetBytes: '1,663', packetTokens: '416' }
  ]

  function summaryValue(label, fallback) {
    return truthSummaryRef.value.find((item) => item.label === label)?.value ?? fallback
  }

  function backendOnline() {
    return fetchStateRef.value === 'Live'
  }

  function backendTone() {
    if (fetchStateRef.value === 'Loading') {
      return 'pending'
    }
    return backendOnline() ? 'good' : 'warn'
  }

  function backendLabel() {
    if (fetchStateRef.value === 'Loading') {
      return 'Checking backend'
    }
    return backendOnline() ? 'Backend online' : 'Backend offline'
  }

  function latestReduction() {
    const ratio = runHistoryRef.value[0]?.budget?.estimated_reduction_ratio
    return typeof ratio === 'number' ? `${Math.round(ratio * 100)}%` : '94.36%'
  }

  function statusModel() {
    return {
      tone: backendTone(),
      label: backendLabel(),
      detail: backendOnline()
        ? 'Live local truth is connected.'
        : 'Start the loopback backend when you want live repository usage.',
      error: fetchErrorRef.value,
      command: 'cargo run -p mcp-server -- --http 127.0.0.1:3030'
    }
  }

  function signalRows() {
    return [
      { label: 'Provider calls', value: 'none' },
      { label: 'Best reduction', value: latestReduction() },
      { label: 'Cache', value: summaryValue('Cache', 'hit proven') },
      { label: 'MCP tools', value: backendToolsRef.value.length > 0 ? String(backendToolsRef.value.length) : '35' }
    ]
  }

  function activityRows() {
    const repo = repositoryStateRef.value[0]
    const run = runHistoryRef.value[0]
    const note = memoryStateRef.value.notes[0]
    return [
      {
        label: 'Backend',
        value: backendLabel(),
        detail: backendOnline() ? 'Loopback truth is live.' : 'Local HTTP is not connected.',
        action: backendOnline() ? 'Ready' : 'Start backend',
        tone: backendTone()
      },
      {
        label: 'Repository',
        value: repo?.repository?.name ?? 'No repository selected',
        detail: repo ? `${repo.sync?.indexed_files ?? 0} indexed files` : 'Add a root query parameter to inspect a local repository.',
        action: repo ? (repo.sync?.status ?? 'Loaded') : 'Add root',
        tone: repo ? 'good' : 'neutral'
      },
      {
        label: 'Recent runs',
        value: run?.query ?? 'No recent runs loaded',
        detail: run ? `${run.budget?.included_bytes ?? 0} of ${run.budget?.raw_bytes_considered ?? 0} bytes included` : 'Assemble context for the selected root, then refresh.',
        action: run ? `Cache ${run.cache_status?.kind ?? 'unknown'}` : runFetchStateRef.value,
        tone: run ? 'good' : 'neutral'
      },
      {
        label: 'Memory matches',
        value: note?.title ?? 'No memory query selected',
        detail: note?.content ?? 'Add a memory query with the same root to show bounded notes.',
        action: note?.profile ?? memoryFetchStateRef.value,
        tone: note ? 'good' : 'neutral'
      }
    ]
  }

  function savingsRows() {
    return benchmarkMetrics
  }

  function boundaryRows() {
    return [
      { label: 'Provider calls', value: 'none' },
      { label: 'State location', value: '.quotarelay' },
      { label: 'HTTP bind', value: 'loopback' },
      { label: 'Billing claims', value: 'none' }
    ]
  }

  function setupRows() {
    return [
      { label: 'Run proof', value: 'scripts\\demo-local.ps1' },
      { label: 'MCP command', value: 'quotarelay-mcp' },
      { label: 'Sync repo', value: '--cli sync repo' }
    ]
  }

  function themeOptions() {
    return [
      { value: 'system', label: 'System' },
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' }
    ]
  }

  function themeButtonClass(mode) {
    return mode === themeModeRef.value ? 'theme-option theme-option--active' : 'theme-option'
  }

  function applyTheme(mode) {
    if (typeof document === 'undefined') {
      return
    }
    if (mode === 'light' || mode === 'dark') {
      document.documentElement.dataset.theme = mode
      document.documentElement.dataset.themePreference = mode
      return
    }
    delete document.documentElement.dataset.theme
    document.documentElement.dataset.themePreference = 'system'
  }

  function setTheme(mode) {
    const nextMode = mode === 'light' || mode === 'dark' ? mode : 'system'
    themeModeRef.value = nextMode
    applyTheme(nextMode)
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(THEME_KEY, nextMode)
    }
  }

  function loadThemePreference() {
    if (typeof localStorage === 'undefined') {
      return 'system'
    }
    const stored = localStorage.getItem(THEME_KEY)
    return stored === 'light' || stored === 'dark' ? stored : 'system'
  }

  async function loadDashboard() {
    const truth = await loadBackendTruth(fetch, '/truth')
    fetchStateRef.value = truth.fetchState
    fetchErrorRef.value = truth.fetchError
    backendToolsRef.value = truth.backendTools
    truthSummaryRef.value = truth.truthSummary

    const params = new URLSearchParams(window.location.search)
    const root = params.get('root') ?? ''
    const memoryQuery = params.get('memory_query') ?? ''

    const repositoryState = await loadRepositoryState(fetch, root)
    repositoryStateRef.value = repositoryState.repositories
    repositoryFetchStateRef.value = repositoryState.fetchState

    const memoryState = await loadMemoryState(fetch, root, memoryQuery)
    memoryStateRef.value = memoryState.memory
    memoryFetchStateRef.value = memoryState.fetchState

    const runState = await loadContextRunState(fetch, root)
    runHistoryRef.value = runState.runs
    runFetchStateRef.value = runState.fetchState
  }

  onMounted(() => {
    const theme = loadThemePreference()
    themeModeRef.value = theme
    applyTheme(theme)
    void loadDashboard()
  })
</script>

<template>
  <main class="focus-shell">
    <header class="topbar">
      <div class="brand-lockup">
        <p class="eyebrow">Local MCP dashboard</p>
        <h1>Quotarelay</h1>
      </div>
      <nav class="topbar-actions" aria-label="Dashboard actions">
        <span :class="`status-pill status-pill--${statusModel().tone}`">{{ statusModel().label }}</span>
        <div class="theme-toggle" aria-label="Theme mode">
          <button
            v-for="option in themeOptions()"
            :key="option.value"
            type="button"
            :class="themeButtonClass(option.value)"
            @click="setTheme(option.value)"
          >
            {{ option.label }}
          </button>
        </div>
        <a class="button button--primary" href="https://github.com/quotarelay/quotarelay">GitHub</a>
        <a class="button button--secondary" href="https://github.com/quotarelay/quotarelay#quickstart">Quickstart</a>
      </nav>
    </header>

    <section class="focus-panel" aria-labelledby="local-context-status">
      <div class="status-copy">
        <p class="eyebrow">Local context status</p>
        <h2 id="local-context-status">{{ statusModel().label }}</h2>
        <p>{{ statusModel().error || statusModel().detail }}</p>
        <div class="command-line" v-if="!backendOnline()">
          <span>Start backend</span>
          <code>{{ statusModel().command }}</code>
        </div>
      </div>
      <dl class="signal-list">
        <div v-for="signal in signalRows()" :key="signal.label">
          <dt>{{ signal.label }}</dt>
          <dd>{{ signal.value }}</dd>
        </div>
      </dl>
    </section>

    <section class="workspace-panel" aria-labelledby="operator-snapshot">
      <div class="workspace-heading">
        <div>
          <p class="eyebrow">Usage</p>
          <h2 id="operator-snapshot">Operator snapshot</h2>
        </div>
        <p>One glance at local health, selected repository state, recent runs, and memory matches.</p>
      </div>
      <div class="snapshot-table">
        <article class="snapshot-row" v-for="row in activityRows()" :key="row.label">
          <span :class="`state-dot state-dot--${row.tone}`"></span>
          <span class="row-label">{{ row.label }}</span>
          <div>
            <strong>{{ row.value }}</strong>
            <p>{{ row.detail }}</p>
          </div>
          <span class="row-action">{{ row.action }}</span>
        </article>
      </div>
    </section>

    <section class="disclosure-stack" aria-label="Supporting details">
      <details class="detail-drawer">
        <summary>
          <span>Savings proof</span>
          <strong>{{ latestReduction() }} best benchmark reduction</strong>
        </summary>
        <div class="proof-table">
          <article class="proof-row" v-for="metric in savingsRows()" :key="metric.mode">
            <div>
              <strong>{{ metric.name }}</strong>
              <span>{{ metric.mode }}</span>
            </div>
            <span>{{ metric.reduction }}</span>
            <p>{{ metric.packetBytes }} packet bytes from {{ metric.rawBytes }} raw bytes; {{ metric.packetTokens }} approximate packet tokens.</p>
          </article>
        </div>
      </details>

      <details class="detail-drawer">
        <summary>
          <span>Boundaries and setup</span>
          <strong>Provider calls: none</strong>
        </summary>
        <div class="support-grid">
          <div class="support-list">
            <article v-for="row in boundaryRows()" :key="row.label">
              <span>{{ row.label }}</span>
              <strong>{{ row.value }}</strong>
            </article>
          </div>
          <div class="support-list">
            <article v-for="row in setupRows()" :key="row.label">
              <span>{{ row.label }}</span>
              <code>{{ row.value }}</code>
            </article>
          </div>
        </div>
      </details>
    </section>
  </main>
</template>
