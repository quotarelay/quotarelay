<meta>
  title: Quotarelay
  description: Apache-2.0 local MCP context compression for coding agents, with bounded retrieval, memory, cache proof, and no hosted dependency.
  keywords: quotarelay, mcp, coding agents, context compression, local first, token savings
  aiSummary: Quotarelay is an MCP-first agent tool that assembles bounded, explainable context packets for coding agents while keeping repository contents local by default.
  aiKeywords: mcp, context-engine, local-first, coding-agents, privacy, open-source
</meta>

<route>
  path: /
</route>

<ai>
  summary: Public product homepage for Quotarelay. Present Quotarelay as a complete Apache-2.0 local MCP agent tool, not a desktop app, hosted service, or teaser for a later product.
  audience:
    - solo developers
    - engineering teams
    - AI coding tool users
  privacy_boundary: Source code, raw context packets, local caches, and .quotarelay state stay local by default.
  adoption_boundary: The local MVP is the product to adopt now; hosted/commercial ideas are deferred planning and not required for the free core.
  tags:
    - public-site
    - local-first
    - mcp
    - context-compression
    - privacy
</ai>

<script>
  import { deploymentSurfaces, surfaceStatusLabel } from '../deploymentSurfaces'

  const localProofMetrics = [
    {
      name: 'exact_search',
      reduction: '94.36%',
      rawBytes: '24,132',
      packetBytes: '1,361',
      packetTokens: '341'
    },
    {
      name: 'overview',
      reduction: '94.05%',
      rawBytes: '24,132',
      packetBytes: '1,435',
      packetTokens: '359'
    },
    {
      name: 'handoff_packet',
      reduction: '88.91%',
      rawBytes: '24,132',
      packetBytes: '2,676',
      packetTokens: '669'
    },
    {
      name: 'diff_aware',
      reduction: '93.15%',
      rawBytes: '24,274',
      packetBytes: '1,663',
      packetTokens: '416'
    }
  ]

  const workflowSteps = [
    {
      title: 'Prove the repo locally',
      command: 'scripts\\demo-local.ps1',
      detail: 'Runs a tiny local repo through sync, memory, exact search, cache, handoff, and backend truth.',
      proof: 'provider_calls: none'
    },
    {
      title: 'Connect an MCP client',
      command: 'quotarelay-mcp',
      detail: 'Use the installed stdio command after the install smoke passes, or run from source during development.',
      proof: 'verified presets'
    },
    {
      title: 'Register and sync work',
      command: '--cli register / --cli sync',
      detail: 'Create a bounded local index under .quotarelay for the repository you want the agent to understand.',
      proof: 'local state only'
    },
    {
      title: 'Ask for bounded context',
      command: '--cli assemble exact_search',
      detail: 'Return relevant snippets, memory notes, omissions, cache status, stale state, and local budget estimates.',
      proof: 'typed reasons'
    }
  ]

  function surfaces() {
    return deploymentSurfaces
  }

  function proofMetrics() {
    return localProofMetrics
  }

  function statusLabel(status) {
    return surfaceStatusLabel(status)
  }

  function steps() {
    return workflowSteps
  }
</script>

<template>
  <main class="public-site">
    <section class="public-hero">
      <div class="public-hero__copy">
        <p class="eyebrow">Apache-2.0 local MCP tool</p>
        <h1>Quotarelay</h1>
        <p class="public-lede">
          Connect Quotarelay to your coding agent so it sends less repo context. The local MCP tool returns relevant
          code, durable decisions, validation commands, cache state, stale-state warnings, and omission reasons without
          uploading your repository by default.
        </p>
        <div class="public-actions">
          <a class="button button--primary" href="https://github.com/quotarelay/quotarelay">GitHub</a>
          <a class="button button--secondary" href="/control-plane">Local control plane</a>
        </div>
      </div>
      <div class="signal-board" aria-label="Quotarelay packet proof summary">
        <div class="signal-board__header">
          <span>Context packet</span>
          <strong>bounded</strong>
        </div>
        <div class="signal-row">
          <span>Raw bytes considered</span>
          <strong>24,132</strong>
        </div>
        <div class="signal-row">
          <span>Packet bytes</span>
          <strong>1,361</strong>
        </div>
        <div class="signal-row">
          <span>Local reduction</span>
          <strong>94.36%</strong>
        </div>
        <div class="signal-row signal-row--accent">
          <span>Repeat retrieval</span>
          <strong>cache hit</strong>
        </div>
      </div>
    </section>

    <section class="public-band public-band--proof">
      <div class="section-heading">
        <p class="eyebrow">Proof, not vibes</p>
        <h2>Current benchmark packets are small, bounded, and locally explainable.</h2>
      </div>
      <p class="proof-note">
        These figures come from the checked-in token-saver benchmark. They compare raw local fixture bytes with
        Quotarelay context packets and approximate token estimates; they are not provider tokenizer output or billing claims.
      </p>
      <div class="metric-grid">
        <article class="metric-card" v-for="metric in proofMetrics()" :key="metric.name">
          <h3>{{ metric.name }}</h3>
          <span class="metric-card__value">{{ metric.reduction }}</span>
          <p>local reduction from raw fixture bytes to the bounded context packet.</p>
          <div class="metric-card__row">
            <span>{{ metric.rawBytes }} raw bytes</span>
            <strong>{{ metric.packetBytes }} packet bytes</strong>
          </div>
          <div class="metric-card__row">
            <span>approx packet tokens</span>
            <strong>{{ metric.packetTokens }}</strong>
          </div>
        </article>
      </div>
    </section>

    <section class="public-band">
      <div class="section-heading">
        <p class="eyebrow">What ships free</p>
        <h2>The local version is the full adoption path.</h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>Agent connection</h3>
          <p>Run from source with Cargo or install the local `quotarelay-mcp` command for stdio MCP clients.</p>
        </article>
        <article class="feature-card">
          <h3>Bounded retrieval</h3>
          <p>Exact, overview, task, and diff-aware modes return limited context with typed inclusion and omission reasons.</p>
        </article>
        <article class="feature-card">
          <h3>Memory and handoff</h3>
          <p>Local decision and guardrail memory can travel with handoff packets, validation suggestions, and blockers.</p>
        </article>
        <article class="feature-card">
          <h3>Savings proof</h3>
          <p>Local demos report raw bytes, packet bytes, approximate tokens, reduction ratio, cache state, and stale state.</p>
        </article>
        <article class="feature-card">
          <h3>Privacy boundary</h3>
          <p>Repository contents, raw packets, local caches, and .quotarelay state stay on your machine unless you opt in later.</p>
        </article>
        <article class="feature-card">
          <h3>Release proof</h3>
          <p>The repo ships local smoke scripts for MCP presets, demos, install checks, public-site checks, and release validation.</p>
        </article>
      </div>
    </section>

    <section class="public-band public-band--workflow">
      <div class="section-heading">
        <p class="eyebrow">First useful workflow</p>
        <h2>Clone, prove, connect, then ask for context your agent can trust.</h2>
      </div>
      <div class="workflow-list">
        <article class="workflow-step" v-for="step in steps()" :key="step.title">
          <div>
            <strong>{{ step.title }}</strong>
            <p><code>{{ step.command }}</code></p>
            <p>{{ step.detail }}</p>
          </div>
          <span class="workflow-step__proof">{{ step.proof }}</span>
        </article>
      </div>
    </section>

    <section class="public-band public-band--split">
      <div>
        <p class="eyebrow">Deferred planning</p>
        <h2>Hosted coordination is sidelined until the local tool earns adoption.</h2>
        <p class="public-copy">
          Quotarelay is not holding core retrieval, memory, cache, validation, handoff, onboarding, or savings proof
          behind a future service. Hosted or enterprise work stays in planning docs until real adoption proves
          what coordination, support, or deployment help users actually need.
        </p>
      </div>
      <ul class="team-list">
        <li>No hosted login required for the local MVP</li>
        <li>No provider keys or prompt forwarding</li>
        <li>No service gate around local context reduction proof</li>
        <li>No desktop or mobile detour before agent-tool adoption</li>
      </ul>
    </section>

    <section class="public-band">
      <div class="section-heading">
        <p class="eyebrow">Platform surfaces</p>
        <h2>One workspace, separate targets.</h2>
      </div>
      <div class="surface-grid">
        <article class="surface-card" v-for="surface in surfaces()" :key="surface.id">
          <div class="surface-card__header">
            <span class="surface-status">{{ statusLabel(surface.status) }}</span>
            <strong>{{ surface.target }}</strong>
          </div>
          <h3>{{ surface.title }}</h3>
          <p>{{ surface.localPreview }}</p>
          <p class="surface-boundary">{{ surface.deploymentBoundary }}</p>
        </article>
      </div>
    </section>
  </main>
</template>
